{
  "name": "productivity-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:ios": "CAP_BUILD=1 vite build && cap sync ios",
    "test": "vitest run",
    "test:db": "node scripts/journal-resource-limits-test.mjs",
    "test:keys": "node scripts/journal-key-namespace-test.mjs",
    "test:security:db": "node scripts/journal-attacker-boundary-test.mjs",
    "test:notion": "node scripts/notion-security-test.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:security:ai-budget": "node scripts/ai-proxy-budget-test.mjs",
    "test:ops": "node --test scripts/public-health-probe.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@revenuecat/purchases-capacitor": "^13.2.2",
    "@supabase/supabase-js": "^2.108.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
